  "components": {
    "schemas": {
      "CreateAppointmentDTO": {
        "required": [
          "appoinmentDate",
          "status"
        ],
        "type": "object",
        "properties": {
          "appoinmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateDepartmentDTO": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "location": {
            "maxLength": 150,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateDoctorDTO": {
        "required": [
          "email",
          "fullName",
          "phone",
          "specialization"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "specialization": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "salary": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "departmentId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreatePatientDTO": {
        "required": [
          "fullName",
          "gender",
          "phone"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "gender": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "phone": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "address": {
            "maxLength": 250,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
